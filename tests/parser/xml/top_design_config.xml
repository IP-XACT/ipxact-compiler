<?xml version="1.0" encoding="UTF-8"?>
<ipxact:designConfiguration xmlns:ipxact="http://www.accellera.org/XMLSchema/IPXACT/1685-2022">
  <ipxact:vendor>example.org</ipxact:vendor>
  <ipxact:library>soc</ipxact:library>
  <ipxact:name>top_design_config</ipxact:name>
  <ipxact:version>1.0</ipxact:version>

  <ipxact:designRef vendor="example.org" library="soc" name="top_design" version="1.0"/>

  <ipxact:interconnectionConfiguration>
    <ipxact:interconnectionRef>cpu_apb_conn</ipxact:interconnectionRef>
    <ipxact:abstractorInstances>
      <ipxact:interfaceRef componentRef="cpu" busRef="apb"/>
      <ipxact:abstractorInstance>
        <ipxact:instanceName>apb_bridge0</ipxact:instanceName>
        <ipxact:abstractorRef vendor="example.org" library="abstractors" name="apb_bridge" version="1.0"/>
        <ipxact:viewName>rtl</ipxact:viewName>
      </ipxact:abstractorInstance>
    </ipxact:abstractorInstances>
  </ipxact:interconnectionConfiguration>

  <ipxact:viewConfiguration>
    <ipxact:instanceName>cpu</ipxact:instanceName>
    <ipxact:view viewRef="rtl">
      <ipxact:configurableElementValues>
        <ipxact:configurableElementValue referenceId="ICACHE_ECC">1</ipxact:configurableElementValue>
      </ipxact:configurableElementValues>
    </ipxact:view>
  </ipxact:viewConfiguration>
  <ipxact:viewConfiguration>
    <ipxact:instanceName>uart0</ipxact:instanceName>
    <ipxact:view viewRef="rtl"/>
  </ipxact:viewConfiguration>
</ipxact:designConfiguration>
